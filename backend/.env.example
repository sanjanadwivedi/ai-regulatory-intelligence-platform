# ReguGuard AI Environment Configuration
# ======================================

# Security & Authentication Secret Key (REQUIRED in production)
# Generate a secure 32-byte secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# JWT Expiration in minutes (Default: 1440 = 24 Hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL (SQLite default for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./compliance_platform.db
# DATABASE_URL=postgresql+asyncpg://compliance_user:secretpass@localhost:5432/compliance_db

# Google Gemini API Key for Multi-Agent AI Ingestion & RAG Copilot
GEMINI_API_KEY=your_google_gemini_api_key_here

# Redis Connection URL (for caching & job scheduling)
REDIS_URL=redis://localhost:6379/0

# Optional Cross-Model Verification Configuration ("anthropic" or "openai")
SECONDARY_LLM_PROVIDER=
SECONDARY_LLM_API_KEY=

# Source URL Re-verification Schedule Interval (in days: 1 = daily, 30 = monthly)
SOURCE_REVERIFY_INTERVAL_DAYS=30

# FINRA Manual Upload Directory
# Download rules from https://www.finra.org/rules-guidance/rulebooks/finra-rules
# Drop PDF/HTML files here for automatic ingestion
FINRA_MANUAL_UPLOAD_PATH=./data/finra_manual

